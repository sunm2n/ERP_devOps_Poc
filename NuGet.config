<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    소스를 저장소에서 고정한다. 이 파일이 없으면 복원 소스가 머신 설정을 따르므로,
    고객사 개발자 PC 에 사내 피드가 등록돼 있으면 **다른 Npgsql 이 들어와도 빌드는 초록불**이다
    (미결 M-4 가 정확히 그 상태를 안 정한 항목이다).

    packageSourceMapping 은 dependency confusion 을 막는다 — 사내 피드를 추가할 때
    어느 패키지가 어디서 오는지를 여기서 못박지 않으면, 공개 피드에 같은 이름을 올리는
    것만으로 대체된다.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
